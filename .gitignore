# --- Credentials / secrets: never commit these ---
credentials.json
client_secret*.json
*.env
.env.*
**/config/secrets*
*api_key*
*apikey*
*token*.json
*.pem
*.key

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
env/

# --- Node (if any tooling ends up needing it) ---
node_modules/

# --- Large / generated data ---
*.zip
*.tar.gz
# Uncomment if you don't want raw paper PDFs tracked in git (use Zenodo instead):
# papers/**/*.pdf

# --- Spreadsheet lock/temp files ---
~$*.xlsx
~$*.docx
